<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permission CAMERA — alasannya SUDAH BUKAN yang dulu ditulis di sini.

         Komentar lamanya nyebut scan langsung lewat paket `camera` di
         `live_scan_screen.dart`. Dua-duanya nggak ada lagi di proyek ini:
         `camera` nggak kedaftar di `pubspec.yaml` maupun `pubspec.lock`, dan
         berkas layar itu nggak ada di `lib/`. Satu-satunya jalan ke kamera
         sekarang lewat `image_picker` — `KameraSumberFoto` di
         `lib/services/photo_source.dart` (jepretan lembar kerja buat OCR
         lokal) dan foto profil di `lib/screens/profile/profile_screen.dart`.

         `image_picker` nembak intent ke app kamera bawaan, dan intent sendiri
         nggak butuh permission — jadi sekarang baris ini secara teknis nggak
         wajib lagi. Tapi dia BUKAN deklarasi kosong: begitu CAMERA kesebut di
         manifest, `image_picker_android` mewajibkan izinnya diminta dulu
         sebelum intent-nya jalan (`ImagePickerDelegate` manggil
         `ImagePickerUtils.needRequestCameraPermission()`, yang isinya cuma
         ngintip manifest ini). Artinya baris ini yang nentuin teknisi kena
         dialog izin sebelum motret atau nggak. Jadi jangan dicabut sambil
         lalu: yang berubah bukan cuma daftar izin di Play/Settings, tapi alur
         foto lembar kerja & foto profil di perangkat asli — uji dua-duanya
         dulu kalau memang mau dicabut.

         Kameranya tetap OPSIONAL biar app masih keinstall di perangkat tanpa
         kamera (mis. emulator lama). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- WAJIB, dan ini sempat kelewat.
         Flutter nyisipin izin ini otomatis ke manifest DEBUG, jadi selama app
         cuma dijalanin lewat `flutter run` semuanya kelihatan normal. Di build
         RILIS penyisipan itu nggak terjadi: APK-nya kepasang, kebuka, lalu
         tiap request gagal tanpa penjelasan. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Memasang APK pemutakhiran dari dalam aplikasi.

         Aplikasi ini TIDAK diedarkan lewat Play Store — teknisi memasangnya
         dari APK langsung, dan sebelum ada izin ini caranya bolak-balik: buka
         GitHub/email, unduh manual, cari di folder Download, pasang. Izin ini
         yang bikin aplikasinya bisa mengunduh penggantinya sendiri lalu
         memanggil pemasang Android.

         `open_filex` SENGAJA mencabut izin ini dari manifest-nya sendiri
         supaya paketnya tetap lolos kebijakan Play Store — jadi aplikasi yang
         memang butuh harus mendeklarasikannya di sini. Kalau suatu hari
         aplikasi ini masuk Play Store, baris inilah yang pertama harus
         dicabut, dan pemutakhirannya pindah ke mekanisme Play.

         Izin ini TIDAK memberi hak memasang diam-diam: Android tetap membuka
         layar konfirmasi pemasang, dan di Android 8+ pengguna masih harus
         mengizinkan "Install unknown apps" buat aplikasi ini sekali. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <application
        android:label="PT Sidik Calibration"
        android:name="${applicationName}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Android 11+ nyembunyiin app lain kecuali disebut di sini. Tanpa
             dua blok ini, `url_launcher` ngira nggak ada yang bisa nangani
             tautan — jadi "Bagikan lewat WhatsApp" & "Kirim email" di lembar
             sertifikat diam aja waktu dipencet, tanpa error. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>
</manifest>
