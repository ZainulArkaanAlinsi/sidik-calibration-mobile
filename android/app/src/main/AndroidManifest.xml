<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permission CAMERA — alasannya SUDAH BUKAN yang dulu ditulis di sini.

         Komentar lamanya nyebut scan langsung lewat paket `camera` di
         `live_scan_screen.dart`. Dua-duanya nggak ada lagi di proyek ini:
         `camera` nggak kedaftar di `pubspec.yaml` maupun `pubspec.lock`, dan
         berkas layar itu nggak ada di `lib/`. Satu-satunya jalan ke kamera
         sekarang lewat `image_picker` — `KameraSumberFoto` di
         `lib/services/photo_source.dart` (jepretan lembar kerja buat OCR
         lokal) dan foto profil di `lib/screens/profile/profile_screen.dart`.

         `image_picker` nembak intent ke app kamera bawaan, dan intent sendiri
         nggak butuh permission — jadi sekarang baris ini secara teknis nggak
         wajib lagi. Tapi dia BUKAN deklarasi kosong: begitu CAMERA kesebut di
         manifest, `image_picker_android` mewajibkan izinnya diminta dulu
         sebelum intent-nya jalan (`ImagePickerDelegate` manggil
         `ImagePickerUtils.needRequestCameraPermission()`, yang isinya cuma
         ngintip manifest ini). Artinya baris ini yang nentuin teknisi kena
         dialog izin sebelum motret atau nggak. Jadi jangan dicabut sambil
         lalu: yang berubah bukan cuma daftar izin di Play/Settings, tapi alur
         foto lembar kerja & foto profil di perangkat asli — uji dua-duanya
         dulu kalau memang mau dicabut.

         Kameranya tetap OPSIONAL biar app masih keinstall di perangkat tanpa
         kamera (mis. emulator lama). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- WAJIB, dan ini sempat kelewat.
         Flutter nyisipin izin ini otomatis ke manifest DEBUG, jadi selama app
         cuma dijalanin lewat `flutter run` semuanya kelihatan normal. Di build
         RILIS penyisipan itu nggak terjadi: APK-nya kepasang, kebuka, lalu
         tiap request gagal tanpa penjelasan. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 13+: tanpa izin ini notifikasi diam-diam tidak muncul. Diminta
         dari kode, BUKAN saat aplikasi pertama dibuka: ada penjelasan singkat
         dulu (`MintaIzinNotifikasi`), lalu dialog sistem. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Memasang APK pemutakhiran dari dalam aplikasi.

         Aplikasi ini TIDAK diedarkan lewat Play Store — teknisi memasangnya
         dari APK langsung, dan sebelum ada izin ini caranya bolak-balik: buka
         GitHub/email, unduh manual, cari di folder Download, pasang. Izin ini
         yang bikin aplikasinya bisa mengunduh penggantinya sendiri lalu
         memanggil pemasang Android.

         `open_filex` SENGAJA mencabut izin ini dari manifest-nya sendiri
         supaya paketnya tetap lolos kebijakan Play Store — jadi aplikasi yang
         memang butuh harus mendeklarasikannya di sini. Kalau suatu hari
         aplikasi ini masuk Play Store, baris inilah yang pertama harus
         dicabut, dan pemutakhirannya pindah ke mekanisme Play.

         Izin ini sendiri TIDAK memberi hak memasang diam-diam, dan di Android
         8+ pengguna masih harus mengizinkan "Install unknown apps" sekali.
         Sejak 15 Sep 2026 pemasangan lewat `PemasangSesi` (PackageInstaller):
         di Android 12+ pemutakhiran KEDUA dan seterusnya bisa masuk tanpa layar
         konfirmasi, karena aplikasi ini sudah tercatat sebagai pemasangnya
         sendiri. Pemasangan pertama & Android 11 ke bawah tetap minta ketukan. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <application
        android:label="PT Sidik Calibration"
        android:name="${applicationName}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Hasil sesi PackageInstaller dari `PemasangSesi`. Tidak diekspor:
             yang mengirim cuma PendingIntent milik aplikasi ini sendiri. -->
        <receiver
            android:name=".PenerimaHasilPasang"
            android:exported="false"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <!-- Notifikasi push (FCM) yang tiba waktu aplikasi di latar/mati digambar
             sistem langsung dari tiga nilai ini — kode Dart tidak jalan. Tanpa
             ikon monokrom Android menampilkan kotak putih; `ic_stat_sidik`
             dibuat `tool/buat_ikon_notifikasi.dart` dari logo. Nama kanal harus
             sama dengan `LocalNotifikasiPerangkat.kanalKerja`. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_sidik"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notif_aksen"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="sidik_kerja"/>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Crashlytics MATI sampai Dart menyalakannya: `main.dart`
             (`_pelaporGalat`) memanggil setCrashlyticsCollectionEnabled(true)
             hanya di build release dengan Firebase hidup. Tanpa ini crash
             native awal di build debug/profile ikut terkirim sebelum Dart
             sempat mematikannya. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <!-- ML Kit UNBUNDLED: minta Google Play Services mengunduh modul OCR &
             barcode (on-device). APK sideload tidak dapat unduhan saat-pasang
             dari Play Store; modulnya turun saat pertama dipakai (butuh
             internet sekali), dan sebelum itu Dart menerima
             `ModulPembacaTeksBelumSiap`. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr,barcode" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Android 11+ nyembunyiin app lain kecuali disebut di sini. Tanpa
             dua blok ini, `url_launcher` ngira nggak ada yang bisa nangani
             tautan — jadi "Bagikan lewat WhatsApp" & "Kirim email" di lembar
             sertifikat diam aja waktu dipencet, tanpa error. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>

        <!-- Android 11+: `image_picker` memanggil app kamera bawaan lewat
             IMAGE_CAPTURE. Tanpa deklarasi ini `resolveActivity` bisa tidak
             melihat app kameranya di sebagian HP, dan foto lembar kerja
             gagal dengan `no_available_camera` walau kameranya ada. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
    </queries>
</manifest>
