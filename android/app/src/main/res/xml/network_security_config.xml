<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTP polos diizinkan HANYA buat alamat server pengembangan.

  Android 9+ mblokir cleartext secara bawaan, dan itu benar: sertifikat
  kalibrasi lewat jaringan tanpa TLS berarti siapa pun di jaringan yang sama
  bisa baca dan ngubah isinya. Jadi yang dilonggarin cuma alamat lokal tempat
  `php artisan serve` jalan selama proyek ini dibangun.

  `cleartextTrafficPermitted="true"` global SENGAJA TIDAK dipakai: itu bakal
  ngizinin HTTP polos ke SELURUH internet, termasuk server produksi nanti —
  dan lubang kayak gitu nggak pernah ketahuan sampai ada yang nyari.

  Waktu backend-nya udah punya domain HTTPS beneran, berkas ini mestinya
  dihapus, bukan ditambahin alamat baru.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Laptop pengembang di jaringan lokal. -->
        <domain includeSubdomains="false">192.168.1.34</domain>

        <!-- Emulator Android nembak host lewat alamat khusus ini. -->
        <domain includeSubdomains="false">10.0.2.2</domain>

        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
