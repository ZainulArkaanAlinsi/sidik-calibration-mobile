<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- SANDBOX SENGAJA DIMATIKAN buat build lokal (unsigned).
	     Kenapa: `flutter_secure_storage` nyimpen token login di Keychain.
	     App sandbox butuh entitlement `keychain-access-groups`, TAPI itu
	     cuma jalan kalau di-sign pakai sertifikat developer — build lokal
	     `flutter build macos` itu unsigned, jadi malah GAGAL build. Tanpa
	     keychain, app sandbox mental balik ke login (token nggak kesimpen).
	     Lepas sandbox = secure_storage + jaringan jalan tanpa sertifikat,
	     login nggak mental. Android (Keystore) & Windows nggak kena isu ini.
	     Kalau nanti mau distribusi resmi ber-sertifikat, sandbox bisa
	     dinyalain lagi + tambah keychain-access-groups. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
