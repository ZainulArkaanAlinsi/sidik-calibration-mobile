# Vault Obsidian (rencana & catatan harian project) — bukan bagian dari kode app.
# JANGAN di-commit: isinya dokumen internal PT Sidik (draft akreditasi LK-285-IDN,
# master perhitungan pH, data kemampuan kalibrasi) dan repo ini publik.
# Nama lama /Project-PT-ASMO/ tetap ditahan buat yang folder lokalnya belum di-rename.
/Project-PT-ASMO/
/Project-PT-Sidik/

# Diff bikinan golden test waktu screenshot nggak cocok. Ke-regenerate sendiri
# tiap test gagal — ini hasil debug, bukan kode. Yang di-commit cuma golden-nya
# (`test/screenshots/`).
/test/failures/

# Formulir & lembar kerja asli PT Sidik (SIDIK-FM-*, SIDIK-IK-*).
# JANGAN di-commit: ini dokumen mutu internal lab terakreditasi, dan repo ini
# publik. Dipakai cuma sebagai acuan waktu ngembangin, bukan bagian dari kode.
SIDIK-FM-*.pdf
SIDIK-IK-*.pdf

# Paket build yang ditaruh di halaman unduh Firebase Hosting. Ukurannya puluhan
# MB dan isinya bisa diregenerasi kapan saja dari workflow "Rilis desktop" —
# yang di-commit cuma halaman unduhnya (`public/index.html`), bukan binernya.
/public/*.zip
/public/*.apk
# Bundel web dirakit di runner (job `terbitkan`), bukan di-commit — sama
# alasannya dengan zip di atas: hasil build, bukan sumber.
/public/app/

# Jejak Firebase CLI.
.firebase/
firebase-debug.log
firebase-debug.*.log

# Konfigurasi Firebase per-aplikasi.
#
# DITAHAN DULU, bukan diputuskan selamanya. Repo ini publik, dan berkas ini
# memuat API key Android proyek `sidik-kalibrasi`. Kunci itu memang ikut
# terbungkus di dalam setiap APK (siapa pun bisa mengeluarkannya) dan Google
# menganggapnya bukan rahasia SELAMA dibatasi ke nama paket + sidik jari SHA-1
# di Google Cloud Console. Kalau pembatasan itu sudah dipasang, berkas ini boleh
# ikut di-commit — dan sebaiknya begitu, karena tanpa dia `flutter build apk`
# gagal di mesin mana pun yang belum punya salinannya.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist

# Kunci penanda tangan APK rilis. Ini rahasia yang BEDA KELAS dari yang di
# atas: `google-services.json` bocor cuma bikin repot, keystore bocor bikin
# siapa pun bisa membangun APK yang Android terima sebagai pembaruan sah
# aplikasi ini — dan aplikasi ini memang memasang pembaruannya sendiri.
#
# Kebalikannya sama gawatnya: keystore HILANG artinya tidak ada lagi APK yang
# bisa dipasang di atas yang sudah terpasang. Setiap teknisi harus uninstall
# manual, dan itu menghapus token login serta foto profilnya. Jadi berkas ini
# tidak di-commit, TAPI wajib punya salinan cadangan di luar repo.
# Selengkapnya: docs/rilis-tanda-tangan-apk.md
android/key.properties
*.jks
*.keystore
