<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Wajib di manifest MAIN: Flutter cuma menyisipkannya otomatis di
         build debug. Tanpa ini build rilis terpasang lalu tiap request gagal. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Izin WARISAN plugin paket `sidik_calibration` (push FCM, notifikasi
         lokal, pemilih foto/berkas) yang Studio tidak pernah pakai: Studio
         tanpa push, tanpa OCR/kamera, tanpa unggah media. Dicabut supaya
         tablet tidak pernah menawarkan izin yang tidak ada gunanya di sini.
         Kalau suatu tahap Studio memang butuh salah satunya, cabut barisnya
         di sini bersama alasan. Daftar asal: `aapt2 dump badging` build
         S0b (10 Okt 2026). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove"/>
    <uses-permission android:name="android.permission.VIBRATE" tools:node="remove"/>
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove"/>
    <!-- Plugin `camera` (kamera "Foto lembar kerja" app lapangan, 13 Nov 2026)
         ikut terbawa lewat paket `sidik_calibration`; manifest-nya menyisipkan
         tiga izin dan fitur kamera WAJIB. Studio tidak memotret: izin dicabut,
         dan fitur kamera dijadikan opsional supaya tablet tanpa kamera tetap
         bisa memasang Studio. `required="false"` SAJA tidak cukup (penggabung
         manifest AGP memakai kebijakan OR untuk `uses-feature`/`required`,
         hasil akhirnya tetap `true`); yang menimpa `tools:node="replace"`. -->
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="false" tools:node="replace"/>
    <!-- Memasang APK pemutakhiran Studio dari dalam aplikasi (banner
         `PembaruApkStudio`). Studio tidak lewat Play Store. `open_filex`
         (dipakai pemasang bersama) sengaja mencabut izin ini dari manifest-nya,
         jadi aplikasi yang butuh harus mendeklarasikannya sendiri; tanpa baris
         ini menu "Install unknown apps" tidak muncul untuk Studio dan tombol
         PASANG selalu ditolak sistem. Izin ini TIDAK memberi hak memasang
         diam-diam: pengguna tetap mengizinkan sekali dan mengetuk "Install".
         Jalur PackageInstaller (`PemasangSesi`) milik app lapangan sengaja
         tidak dibawa; pemasangan lewat `open_filex`. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <application
        android:label="Sidik Studio"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
